# Voice Agent configuration — copy to .env (gitignored, chmod 600) and fill in.
# Only ANTHROPIC_API_KEY is required for the default (Claude) brain.

# --- Secrets ---
ANTHROPIC_API_KEY=

# --- Brain selection ---
# local (default) = use the raw LLM below. gabagent = talk to gabagent's agent over the
# Brain protocol (voice-agent spawns `gab --voice-serve` and streams its replies).
BRAIN=local
# gabagent brain settings (only used when BRAIN=gabagent):
# GAB_BIN=~/dev/gabagent/.venv/bin/gab          # gab voice-serve binary
# GAB_PORT=8765                                  # loopback port for the brain server
# GAB_PROJECT_DIR=                               # project dir the brain works in (default: cwd)

# --- Provider selection (see config.py factories) ---
# STT: whisper | deepgram
STT_PROVIDER=whisper
# TTS: kokoro | cartesia | elevenlabs
TTS_PROVIDER=kokoro
# Kokoro voice (default af_heart). Others: af_bella af_sarah af_nicole am_michael am_adam bf_emma …
# TTS_VOICE=af_heart
# LLM: anthropic | openai | ollama
LLM_PROVIDER=anthropic

# --- Model toggles ---
# Anthropic default; drop to claude-haiku-4-5-20251001 if latency-bound.
LLM_MODEL=claude-sonnet-4-6
# For LLM_PROVIDER=openai/ollama point at an OpenAI-compatible endpoint:
# LLM_BASE_URL=http://localhost:11434/v1   # local Ollama on the RX 7900 XT
# LLM_MODEL=llama3.1:8b

# Whisper size: small.en (default) | base.en (faster, less accurate)
STT_MODEL=small.en

# --- Cloud-swap keys (only needed if you select those providers) ---
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=

# --- Audio ---
# PipeWire/PyAudio input device. Leave blank to auto-pick the C110; set an index to force it.
# AUDIO_INPUT_DEVICE_INDEX=
