# Voice Agent configuration — copy to .env (gitignored, chmod 600) and fill in.
# Only ANTHROPIC_API_KEY is required for the default (Claude) brain.

# --- Secrets ---
ANTHROPIC_API_KEY=

# --- Brain selection ---
# local (default) = use the raw LLM below. gabagent = talk to gabagent's agent over the
# Brain protocol (voice-agent spawns `gab --voice-serve` and streams its replies).
BRAIN=local
# gabagent brain settings (only used when BRAIN=gabagent):
# GAB_BIN=~/dev/gabagent/.venv/bin/gab          # gab voice-serve binary
# GAB_PORT=8765                                  # loopback port for the brain server
# GAB_PROJECT_DIR=                               # project dir the brain works in (default: cwd)

# --- Provider selection (see config.py factories) ---
# STT: whisper | deepgram
STT_PROVIDER=whisper
# TTS: kokoro | cartesia | elevenlabs
TTS_PROVIDER=kokoro
# Kokoro voice (default af_heart). Others: af_bella af_sarah af_nicole am_michael am_adam bf_emma …
# TTS_VOICE=af_heart
# Aria's own voice level (0..1; 1.0 = full/no attenuation). She's duck-excluded so she rides at full level
# over ducked music — this lowers her so she's not disproportionately loud. Default 0.55.
# TTS_GAIN=0.55
# Runtime voice-volume control ("lower your voice" / "speak up" / "set your voice to half"): the brain
# classifies the my-voice intent and emits a voice_volume event; up/down step the live gain by TTS_VOLUME_STEP,
# and "down" floors at TTS_VOLUME_FLOOR so repeated "quieter" can't reach inaudible (an explicit "set to 0" can).
# TTS_VOLUME_STEP=0.1
# TTS_VOLUME_FLOOR=0.1
# LLM: anthropic | openai | ollama
LLM_PROVIDER=anthropic

# --- Model toggles ---
# Anthropic default; drop to claude-haiku-4-5-20251001 if latency-bound.
LLM_MODEL=claude-sonnet-4-6
# For LLM_PROVIDER=openai/ollama point at an OpenAI-compatible endpoint:
# LLM_BASE_URL=http://localhost:11434/v1   # local Ollama on the RX 7900 XT
# LLM_MODEL=llama3.1:8b

# Whisper size: small.en (default) | base.en (faster, less accurate)
STT_MODEL=small.en

# --- Cloud-swap keys (only needed if you select those providers) ---
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=

# --- Audio devices ---
# Pin the PipeWire/PyAudio devices. _INDEX (numeric, from the startup device log) wins; _NAME is a
# case-insensitive substring resolved at startup. Leave blank for the OS default — but the default
# OUTPUT can change mid-session (e.g. a monitor move), silently sending TTS to a dead sink, so
# prefer pinning the output by name. The startup log reads back whatever was actually selected.
# AUDIO_INPUT_DEVICE_INDEX=
# AUDIO_OUTPUT_DEVICE_INDEX=
# AUDIO_INPUT_DEVICE_NAME=C110
# AUDIO_OUTPUT_DEVICE_NAME=
# Cold-boot/login readiness: WirePlumber creates a PipeWire echo-cancel (AEC) source asynchronously, so on
# autostart it may not exist yet at launch. When pinning the input by NAME, wait up to this many seconds for
# it to appear before enumerating; on timeout, fall over to the default mic (degraded, no echo-cancel).
# 0 = don't wait. Ignored when pinning by index. Default 60.
# AUDIO_INPUT_WAIT_SECS=60

# --- Turn-taking ---
# VAD silence before SmartTurn inference triggers (keep 0.2 — SmartTurn v3 is trained for it).
# VAD_STOP_SECS=0.2
# SmartTurn's hard max-silence fallback before force-completing a turn. Raise to absorb mid-thought
# pauses so multi-clause requests aren't split into separate turns (default 4.0; library default 3).
# SMART_TURN_STOP_SECS=4.0
# Honor SmartTurn's INCOMPLETE verdict over pipecat's transcript-fallback / STT-p99 timeout, which can
# otherwise end a turn the model judged unfinished and cut you off on a natural pause. Default on; set 0
# to revert to stock pipecat behavior. (turn_stop.SmartTurnHonoringStopStrategy)
# TURN_HONOR_INCOMPLETE=1
# Wall-clock cap so a long continuous ramble can't hang the turn (SmartTurn has no turn-length cap).
# Force-completes a turn past this many seconds when there's transcribed text. Default 15.
# MAX_TURN_SECS=15
# Narration guard for the destructive voice-control gates (shutdown / sleep). A phrase like "shut down
# voice mode" fires only when it's the SUBSTANCE of the utterance, not buried in a longer blob — measured
# as the residual word count after stripping the matched phrase and filler/politeness words. This stops a
# dictation swept into a 15s runaway-turn (whose tail happened to be a shutdown phrase) from killing the
# session. Raise to allow wordier commands, lower to be stricter. Default 3.
# DESTRUCTIVE_CMD_MAX_RESIDUAL_WORDS=3
# VAD sensitivity — the "hear me over the music" ruler. Silero AND-gates on BOTH confidence and volume,
# so a voice masked by playing media can fail either. Lower = more sensitive (hears you over louder
# music) but risks false triggers; raise = the reverse. Defaults start more sensitive than pipecat's
# (0.7/0.6) and pair with the brain's gentle ambient duck. Set VAD_DEBUG=1 to log near-misses
# (volume- vs confidence-gated) while tuning.
# VAD_CONFIDENCE=0.6
# VAD_MIN_VOLUME=0.4
# VAD_DEBUG=0
#
# --- Wake word (opt-in) ---
# Require a wake word before commands WHILE MEDIA PLAYS, so commands land on ducked audio instead of
# being garbled by the music (full STT can't recognize over media; a binary wake-word detector can).
# Set to an openWakeWord pretrained model to enable: hey_jarvis | alexa | hey_mycroft | hey_rhasspy
# (comma-separate for several). Unset = open-mic always (no wake word). Custom "Aria" is a follow-up.
# WAKE_WORD=hey_jarvis
# Detection score 0-1 to trigger (higher = fewer false fires, more misses).
# WAKE_WORD_THRESHOLD=0.5
# openWakeWord's built-in Silero VAD gate (0 disables) — extra guard against false accepts.
# WAKE_WORD_VAD_THRESHOLD=0.5
# Speex noise suppression: 1 = pre-suppress STATIONARY background (music) before the wake model — the
# documented openWakeWord lever for hearing the wake word over media. Needs the speexdsp-ns wheel (Linux
# x86/arm64); falls back to off if unavailable. A/B it: measure the over-music wake_peak with it on vs off.
# WAKE_WORD_SPEEX_NS=0
# Sustained-wake: require N consecutive frames (~80ms each) >= threshold before the wake fires. Isolated
# false-positives (music / asleep acoustic transients) are 1-frame spikes, so >=2 rejects them. 3 proved
# too strict over a movie via an AEC mic (the score flickers, so a clean "Aria" rarely holds 3 in a row,
# and the extra frame adds detection lag); 2 keeps phantom rejection while recovering real wakes. 1 = fire
# on a single frame (max recall, but a lone blip can false-wake). The near-miss log (WAKE_WORD_DEBUG) reports
# "peaked N/M frames" so you can tell whether a lower value would have caught a missed wake.
# WAKE_CONSEC_FRAMES=2
# While ASLEEP, require this many consecutive frames (default 3, clamped to >= WAKE_CONSEC_FRAMES). Asleep is
# the high-cost-of-false-positive state — a missed real wake just needs a repeat, but a false wake (e.g. a
# radio/TV the AEC can't cancel spiking the model to ceiling) is the "she won't stay asleep" bug. A stricter
# sustain rejects brief ambient coincidences; the text wake-gate (the transcript must name her and can't be a
# sleep phrase) is the catch-all. Default lowered to 2 on 2026-06-19 — at 3, real wake-from-sleep over a movie
# missed clean "Aria"s that flickered to 2 frames; 2 recovers them. Paired with the gated-retry escape below.
# WAKE_ASLEEP_CONSEC_FRAMES=2
# Gated-retry escape: whenever the wake is GATED (asleep OR awake-with-media-playing — both lock the mic behind
# the wake word), if you clearly try AGAIN — this many separate >=threshold near-wakes (each one short of the
# sustain) within WAKE_GATED_RETRY_SECS — open the gate anyway. Media rarely fires two near-perfect "Aria" bursts
# seconds apart; a person re-waking does. Catches the residual 1-frame flicker over a movie/music the lowered
# sustain can't. COUNT=0 disables. Only fires while gated (an open mic needs no escape).
# WAKE_GATED_RETRY_COUNT=2
# WAKE_GATED_RETRY_SECS=6.0
# Seconds the command window stays open after the wake word (refreshed by each command).
# WAKE_WINDOW_SECS=15
# 0 (default) = partial duck (media only dips) for the command window — enough when an AEC mic keeps media
# out of the mic. Set 1 to full-mute media (0%) on a box WITHOUT echo-cancel, so no vocal bleeds into STT.
# WAKE_WINDOW_MUTE=0
# Release the wake pre-duck after this many seconds if NO speech follows the wake word, so an unused or
# phantom wake doesn't hold media ducked for the whole window. Held while you OR the bot are speaking;
# once a command is transcribed the media-duck owns restore (when the bot finishes). 0 = old behaviour
# (the pre-duck holds until the window closes). 6s matches the "hear the duck, then speak the command"
# loop — a shorter grace releases the duck before you begin, so the command lands over restored audio.
# WAKE_PREDUCK_GRACE=6.0
# A media keepalive (after a play/resume/etc.) does NOT pre-duck — dipping the song the command just started
# is the "it dips the song I just played" annoyance, so the keepalive only holds the command window open, it
# doesn't dip media. This knob is the SHORT release grace for a pre-duck left ON from a PRIOR fresh "Hey Aria"
# when a media command then fires a keepalive: release it promptly (don't strand the dip for the whole hold)
# rather than waiting the full WAKE_PREDUCK_GRACE. Independent of WAKE_PREDUCK_GRACE (a fresh wake's own grace).
# WAKE_PREDUCK_GRACE_KEEPALIVE=1.0
# Hard ceiling (seconds) on the brain's media-keepalive hold. After a media command the brain asks the gate
# to hold the command window open (a `wake_hold` event with a TTL) so a follow-up command needs no re-wake;
# the TTL is clamped to this, and the gate auto-releases at it if the brain's refreshes stop (crash/dropped
# turn) — so a runaway/never-refreshed hold can't pin the mic open. Keep it above the brain's keepalive TTL.
# WAKE_HOLD_MAX_SECS=120.0
# 1 = only require the wake word while media is playing (open-mic when quiet); 0 = always require it.
# WAKE_WORD_MEDIA_ONLY=1
# 1 (default) = gate active VIDEO behind the wake word too (a movie only ducks once you say "Aria"; no
# duck on asides). Safe with an AEC echo-cancel mic, which keeps the movie out of the mic so the wake word
# is heard cleanly over it. Set 0 on a box WITHOUT echo-cancel, where the movie would mask the wake word
# and lock you out (pass-through instead). Needs a brain whose /media/state reports {"kind":"audio"|"video"}.
# WAKE_GATE_VIDEO=1
# 1 (default) = gate the MEDIA DUCK behind the wake word, for ALL playback (audio + video): media only dips
# once you've said "Hey Aria" (window open), not on ambient room speech. The on-wake pre-duck still fires
# immediately, so a real wake ducks at once; this only stops music/movies from dipping every time someone
# in the room talks. Set 0 to duck on any speech onset over media (the old behavior). Note: in the
# keepalive/idle tail after a media command (the window held open OVER the song you just started), a RAW
# speech onset no longer ducks — that's the media's own audio tripping VAD, not a command; a real follow-up
# command still ducks via its transcription. Kills the "music dips with no wake word" trickle (2026-06-16).
# DUCK_REQUIRE_WAKE=1
# Hold the media duck through the WHOLE brain think, not just the idle grace after speech stops. While the
# brain is working (BotThinkingFrame active) the bed stays ducked however long the lookup takes, so a slow
# 15–60s media/TIDAL search no longer lets the music pop to full volume mid-think and re-duck on the reply
# (the "bob-up"). DUCK_MAX_HOLD_SECS is a safety ceiling: if a turn stays "thinking" pathologically long
# (no reply, no aside, no error), restore the bed rather than hold it ducked forever. 120s is far above the
# worst real think (~64s), so it never fires on a normal turn — it only backstops a hung turn.
# DUCK_MAX_HOLD_SECS=120
# Conversation-hold: after an ADDRESSED reply over playing media (audio OR video), keep the bed ducked + the
# floor open this many seconds so a follow-up needs no re-wake and the bed doesn't bob down→up→down between
# turns. Refreshed on each follow-up. Ends on: this idle timeout, "go to sleep", or shutdown — each restores
# the bed. 0 disables (immediate restore the moment Aria stops speaking, the pre-2026-06-19 behavior). Clamped
# to WAKE_WINDOW_SECS (the gate's command window re-arms per reply; a longer hold would re-gate mid-convo).
# DUCK_CONVO_HOLD_SECS=8
# V2 barge-in (default OFF): while Aria is SPEAKING, saying the wake word ("Aria") cuts her TTS and opens the
# floor for your redirect (works in half-duplex, where open barge-in is disabled). Reuses the aria_nano wake
# model for now (a dedicated "stop" model is a planned follow-up). THRESHOLD defaults to WAKE_WORD_THRESHOLD;
# CONSEC 2 rejects 1-frame TTS-bleed spikes; REFRACTORY gates repeat fires. Set WAKE_INTERRUPT=1 to enable.
# WAKE_INTERRUPT=0
# WAKE_INTERRUPT_THRESHOLD=    # blank = use WAKE_WORD_THRESHOLD
# WAKE_INTERRUPT_CONSEC=2
# WAKE_INTERRUPT_REFRACTORY=1.0
# ARM_DELAY suppresses the interrupt fire for the first N secs after Aria starts speaking — AEC needs a beat
# to converge on a new TTS utterance, and until it does her own voice leaks through and self-trips the
# detector at her speech onset. A real user interrupt comes later, so this kills the onset self-trips.
# Default 1.0s: live (2026-06-16) the AEC onset transient self-tripped at dt=0.62–0.67s past a 0.6s window;
# real user interrupts came at ≥2.6s, so 1.0s clears the transient with margin and is well under a real barge.
# WAKE_INTERRUPT_ARM_DELAY=1.0
# Lockout ESCAPE hatch: if the weak model can't clear threshold over media but the user is clearly
# trying, open the gate anyway after WAKE_ESCAPE_COUNT sub-threshold bursts (peak >= WAKE_ESCAPE_FLOOR)
# within WAKE_ESCAPE_SECS. Set COUNT=0 to disable. (The 2026-06-03 over-movie lockout: "Aria" peaked
# 0.22-0.43, just under 0.40 — these let you in instead of saying it 10× to no avail.)
# WAKE_ESCAPE_FLOOR=0.15
# WAKE_ESCAPE_COUNT=3
# WAKE_ESCAPE_SECS=12
# Near-miss diagnostic: 1 = log sub-threshold scores (peak per utterance) so you can SEE the times the
# wake word was said but scored just under the bar — the wake log otherwise shows only hits, never the
# effort/misses. Also emits "GATE |" media=gating/pass-through transition lines. Use it to set
# WAKE_WORD_THRESHOLD from real data: "WAKE | near-miss aria=0.42".
# WAKE_WORD_DEBUG=0
# Floor for the near-miss log (default 0.05 — low, so sub-0.2 "Aria" peaks over music are visible; the
# masked-out wake word that causes a lockout scores below 0.2, so a higher floor would hide it).
# WAKE_WORD_DEBUG_FLOOR=0.05
# Listen-first (default): a bare wake ("Hey Aria" with no command) gets NO spoken greeting — Aria opens the
# floor and listens (the eye shows 'listening'), and speaks only in response to an actual command. A fixed-timer
# greeting can't help a user who pauses to formulate (the pause outlasts the timer, so it fires right as you
# start talking and cuts you off). Set BARE_WAKE_GREET=1 to restore the old "Yes? Did you need something?"
# prompt (then BARE_WAKE_PROMPT_DELAY is the wait before it speaks; a command within the wait cancels it).
# Name + command ("Hey Aria, play a movie") always strips the wake word and forwards only the command.
# BARE_WAKE_GREET=0
# BARE_WAKE_PROMPT_DELAY=3.5
# When woken FROM SLEEP by a bare wake, if no command follows within this many seconds, return to sleep
# silently ("listen, wait, then go back to sleep if nothing comes"). A command cancels it. >= WAKE_WINDOW_SECS
# so a slow command still lands first. Only applies to wake-from-sleep; an already-awake bare wake just lets
# the gate's command window idle-close.
# BARE_WAKE_RESLEEP_SECS=15.0
# --- Input-stall watchdog (mic capture freeze recovery) ---
# Detects a frozen mic capture — both "no frames" and "frames but silent" (the AEC echo-cancel source
# going dead after a media window closes, which hung Aria for 89s on 2026-06-03) — logs "INPUT STALL"
# and best-effort restarts capture instead of hanging silently. Seconds of no frames before it fires;
# set 0 to disable the watchdog entirely.
# INPUT_STALL_SECS=5.0
# Seconds of arriving-but-silent frames before treating it as a dead source (longer, so a real pause
# doesn't trip it; a live quiet room's noise floor is not "silent").
# INPUT_SILENT_SECS=8.0
# Heartbeat: emit one liveness line every N seconds — "INPUT | hb frames=+N silent=+M | gate gated=…
# open=… wake_peak=0.NN". Its ABSENCE means the event loop froze; its CONTENT distinguishes a freeze
# (frames=+0) from a silent source (frames>0, all silent) from a LOCKOUT (gated=True open=False, low
# wake_peak = wake word masked by media). Set 0 to disable.
# INPUT_HEARTBEAT_SECS=10.0
# PREVENTION for that freeze: pin the speaker to the REAL hardware sink (not the echo-cancel virtual
# sink) so closing an app can't move the system default and disrupt the AEC source. Find the name via
# `wpctl status` / `pactl list sinks short`. (AUDIO_OUTPUT_DEVICE_NAME is documented above.)
# Half-duplex (default 1): mute the mic while Aria speaks (no barge-in) — safe on open speakers.
# Set 0 for full-duplex barge-in; needs headphones or a PipeWire echo-cancel source.
# HALF_DUPLEX=1
# Half-duplex only (default 1): also mute the mic through the brain's "thinking" gap — between the turn
# starting and the first spoken word. AlwaysUserMuteStrategy only mutes while Aria is *speaking*, leaving
# that gap open; on a higher-latency brain (Claude) a stray VAD onset there cancels the silent in-flight
# turn before it says anything (the empty `said so far: ''` barge-ins). Set 0 to revert to speaking-only
# muting. No effect in full-duplex.
# MUTE_DURING_THINKING=1
# Full-duplex only: words required to interrupt Aria while she's speaking (filters TTS/media bleed).
# BARGE_IN_MIN_WORDS=2
# Half-duplex (default 1): transcribed words required to START a turn. The pipecat default starts a turn on
# a bare VAD onset (no words), which broadcasts an interruption that cancels any in-flight bot turn — so your
# own trailing audio just after a turn closes can fire a wordless `said so far: ''` barge-in that drops a
# reply you were waiting on (2026-06-15). Requiring >=1 word kills that; a single real word still starts a
# turn immediately, and the media duck rides the separate VAD path. Set 0 to restore the bare-VAD default.
# HALF_DUPLEX_START_MIN_WORDS=1

# --- Aria "HAL eye" status indicator (aria_state.py → the Conky eye panel) ---------------------------
# The voice agent publishes its semantic state (off/idle/listening/thinking/speaking) to a tmpfs file
# (${XDG_RUNTIME_DIR}/aria/state, JSON {state,level,ts}) that a separate Conky eye panel reads. This is
# a cosmetic side-channel — write errors are swallowed and never affect the conversation.
# Set 0 to disable publishing entirely (no file writes).
# ARIA_EYE_STATE=1
# Visibility boost for the `speaking` amplitude (`level`): raw normalized speech RMS is small (~0.05-0.3),
# so it's multiplied by this gain (then clamped to 0..1) to give the eye a livelier pulse. Tune to taste.
# ARIA_EYE_LEVEL_GAIN=4.0
