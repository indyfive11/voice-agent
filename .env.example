# Voice Agent configuration — copy to .env (gitignored, chmod 600) and fill in.
# Only ANTHROPIC_API_KEY is required for the default (Claude) brain.

# --- Secrets ---
ANTHROPIC_API_KEY=

# --- Brain selection ---
# local (default) = use the raw LLM below. gabagent = talk to gabagent's agent over the
# Brain protocol (voice-agent spawns `gab --voice-serve` and streams its replies).
BRAIN=local
# gabagent brain settings (only used when BRAIN=gabagent):
# GAB_BIN=~/dev/gabagent/.venv/bin/gab          # gab voice-serve binary
# GAB_PORT=8765                                  # loopback port for the brain server
# GAB_PROJECT_DIR=                               # project dir the brain works in (default: cwd)

# --- Provider selection (see config.py factories) ---
# STT: whisper | deepgram
STT_PROVIDER=whisper
# TTS: kokoro | cartesia | elevenlabs
TTS_PROVIDER=kokoro
# Kokoro voice (default af_heart). Others: af_bella af_sarah af_nicole am_michael am_adam bf_emma …
# TTS_VOICE=af_heart
# LLM: anthropic | openai | ollama
LLM_PROVIDER=anthropic

# --- Model toggles ---
# Anthropic default; drop to claude-haiku-4-5-20251001 if latency-bound.
LLM_MODEL=claude-sonnet-4-6
# For LLM_PROVIDER=openai/ollama point at an OpenAI-compatible endpoint:
# LLM_BASE_URL=http://localhost:11434/v1   # local Ollama on the RX 7900 XT
# LLM_MODEL=llama3.1:8b

# Whisper size: small.en (default) | base.en (faster, less accurate)
STT_MODEL=small.en

# --- Cloud-swap keys (only needed if you select those providers) ---
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=

# --- Audio devices ---
# Pin the PipeWire/PyAudio devices. _INDEX (numeric, from the startup device log) wins; _NAME is a
# case-insensitive substring resolved at startup. Leave blank for the OS default — but the default
# OUTPUT can change mid-session (e.g. a monitor move), silently sending TTS to a dead sink, so
# prefer pinning the output by name. The startup log reads back whatever was actually selected.
# AUDIO_INPUT_DEVICE_INDEX=
# AUDIO_OUTPUT_DEVICE_INDEX=
# AUDIO_INPUT_DEVICE_NAME=C110
# AUDIO_OUTPUT_DEVICE_NAME=

# --- Turn-taking ---
# VAD silence before SmartTurn inference triggers (keep 0.2 — SmartTurn v3 is trained for it).
# VAD_STOP_SECS=0.2
# SmartTurn's hard max-silence fallback before force-completing a turn. Raise to absorb mid-thought
# pauses so multi-clause requests aren't split into separate turns (default 4.0; library default 3).
# SMART_TURN_STOP_SECS=4.0
# VAD sensitivity — the "hear me over the music" ruler. Silero AND-gates on BOTH confidence and volume,
# so a voice masked by playing media can fail either. Lower = more sensitive (hears you over louder
# music) but risks false triggers; raise = the reverse. Defaults start more sensitive than pipecat's
# (0.7/0.6) and pair with the brain's gentle ambient duck. Set VAD_DEBUG=1 to log near-misses
# (volume- vs confidence-gated) while tuning.
# VAD_CONFIDENCE=0.6
# VAD_MIN_VOLUME=0.4
# VAD_DEBUG=0
#
# --- Wake word (opt-in) ---
# Require a wake word before commands WHILE MEDIA PLAYS, so commands land on ducked audio instead of
# being garbled by the music (full STT can't recognize over media; a binary wake-word detector can).
# Set to an openWakeWord pretrained model to enable: hey_jarvis | alexa | hey_mycroft | hey_rhasspy
# (comma-separate for several). Unset = open-mic always (no wake word). Custom "Aria" is a follow-up.
# WAKE_WORD=hey_jarvis
# Detection score 0-1 to trigger (higher = fewer false fires, more misses).
# WAKE_WORD_THRESHOLD=0.5
# openWakeWord's built-in Silero VAD gate (0 disables) — extra guard against false accepts.
# WAKE_WORD_VAD_THRESHOLD=0.5
# Seconds the command window stays open after the wake word (refreshed by each command).
# WAKE_WINDOW_SECS=15
# 1 = only require the wake word while media is playing (open-mic when quiet); 0 = always require it.
# WAKE_WORD_MEDIA_ONLY=1
# Half-duplex (default 1): mute the mic while Aria speaks (no barge-in) — safe on open speakers.
# Set 0 for full-duplex barge-in; needs headphones or a PipeWire echo-cancel source.
# HALF_DUPLEX=1
# Full-duplex only: words required to interrupt Aria while she's speaking (filters TTS/media bleed).
# BARGE_IN_MIN_WORDS=2
