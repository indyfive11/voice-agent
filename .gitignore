# Secrets
.env

# Python / venv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Session + transcript logs
logs/

# Inter-agent coordination drops (ephemeral message-passing with the gabagent brain, joined on
# session_id — not project source; kept on disk locally but never tracked).
GABAGENT_*.md
VOICE_MODE_*.md

# uv
# (uv.lock IS committed for reproducibility — do not ignore it)

# Local Pipecat fork (escape hatch — see pyproject.toml [tool.uv.sources])
vendor/

# Wake-word training (isolated venv + multi-GB datasets/clips/features — never tracked).
# The config.yaml + fetch_data.sh + RUN.md under wake-train/ ARE worth keeping; the rest isn't.
train-env/
wake-train/data/
wake-train/features/
wake-train/trained_models/
wake-train/music/
wake-train/SonicWeave-v2/
wake-train/SonicWeave-v2.zip
wake-train/NwwResourcesModel/

# Model caches downloaded on first run (Whisper / Kokoro / Silero / SmartTurn)
models/
*.onnx
*.bin
# ...but DO version our own small, self-trained wake-word models (e.g. hey_aria.onnx).
!wakewords/*.onnx
# ...EXCEPT speaker-specific voice models (trained on a real user's voice) — keep those local.
# Train your own per wake-train/RUN.md; the bare openWakeWord aria.onnx ships as a starting point.
wakewords/aria_nano*.onnx
